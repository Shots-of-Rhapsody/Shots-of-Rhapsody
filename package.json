{
  "name": "fuwari",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "verify:site": "node scripts/verify-built-site.mjs",
    "verify:release": "node scripts/verify-built-site.mjs --require-signoff",
    "verify:semantic": "node scripts/compare-built-html.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check",
    "new-post": "node scripts/new-post.js",
    "archive:import": "node scripts/archive/import.js",
    "archive:verify": "node scripts/archive/verify.js",
    "test:archive": "node --test scripts/archive/test/*.test.js",
    "test:migration": "node --test scripts/content-id.test.mjs",
    "test:release-tools": "node --test scripts/release/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:repository": "node scripts/release/audit-repository.mjs",
    "audit:gitleaks": "node scripts/release/run-gitleaks.mjs",
    "audit:dependencies": "pnpm audit --json",
    "format": "biome format --write ./src ./scripts/archive ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
    "lint": "biome check ./src ./scripts/archive ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
    "lint:ci": "biome ci ./src ./scripts/archive ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts --reporter=github",
    "lint:fix": "biome check --write ./src ./scripts/archive ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
    "preinstall": "only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "0.44.1",
    "@expressive-code/plugin-collapsible-sections": "0.44.1",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.50",
    "@iconify/svelte": "^4.2.0",
    "@swup/astro": "1.8.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "astro-expressive-code": "0.44.1",
    "astro-icon": "^1.1.5",
    "hastscript": "^9.0.1",
    "katex": "^0.16.27",
    "markdown-it": "14.3.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.12.0",
    "pagefind": "1.4.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "stylus": "^0.64.0",
    "svelte": "5.56.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@astrojs/ts-plugin": "1.10.10",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@types/hast": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.0",
    "only-allow": "1.2.2",
    "parse5": "7.3.0"
  },
  "packageManager": "pnpm@11.16.0"
}
