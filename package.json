{
	"name": "shots-of-rhapsody",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"build": "astro build && pagefind --site dist",
		"verify:site": "node scripts/verify-built-site.mjs",
		"verify:release": "node scripts/release/verify-release.mjs",
		"verify:semantic": "node scripts/compare-built-html.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "astro check",
		"new-post": "node scripts/content/new.js",
		"archive:import": "node scripts/archive/import.js",
		"archive:verify": "node scripts/archive/verify.js",
		"content:new": "node scripts/content/new.js",
		"content:verify": "node scripts/content/verify.js",
		"content:presentation-evidence": "node scripts/content/presentation-evidence.js",
		"content:master-package": "node scripts/content/master-package.js",
		"content:master-verify": "node scripts/content/master-verify.js",
		"medium:inventory": "node scripts/medium/inventory.js",
		"medium:review-inventory": "node scripts/medium/review-inventory.js",
		"medium:assets": "node scripts/medium/assets.js",
		"medium:hero-anchor": "node scripts/medium/hero-anchor.js",
		"medium:sanitize-image": "node scripts/medium/sanitize-image.js",
		"medium:finalize-inventory": "node scripts/medium/finalize-inventory.js",
		"medium:import": "node scripts/medium/import.js",
		"medium:review-scaffold": "node scripts/medium/review-scaffold.js",
		"medium:verify": "node scripts/medium/verify.js",
		"podcast:review": "node scripts/podcast/review.mjs",
		"podcast:verify": "node scripts/podcast/verify.mjs",
		"test:archive": "node --test scripts/archive/test/*.test.js",
		"test:future-content": "node --test scripts/content/test/*.test.js scripts/medium/test/*.test.js scripts/podcast/*.test.mjs",
		"test:migration": "node --test scripts/content-id.test.mjs",
		"test:release-tools": "node --test scripts/release/*.test.mjs",
		"test:e2e": "playwright test",
		"audit:repository": "node scripts/release/audit-repository.mjs",
		"audit:gitleaks": "node scripts/release/run-gitleaks.mjs",
		"audit:dependencies": "pnpm audit --json",
		"format": "biome format --write ./src ./scripts/archive ./scripts/content ./scripts/medium ./scripts/podcast ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
		"lint": "biome check ./src ./scripts/archive ./scripts/content ./scripts/medium ./scripts/podcast ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
		"lint:ci": "biome ci ./src ./scripts/archive ./scripts/content ./scripts/medium ./scripts/podcast ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts --reporter=github",
		"lint:fix": "biome check --write ./src ./scripts/archive ./scripts/content ./scripts/medium ./scripts/podcast ./scripts/release ./scripts/verify-built-site.mjs ./scripts/compare-built-html.mjs ./scripts/content-id.test.mjs ./tests ./playwright.config.ts",
		"preinstall": "only-allow pnpm"
	},
	"dependencies": {
		"@astrojs/check": "0.9.9",
		"@astrojs/markdown-remark": "7.2.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@fontsource-variable/noto-serif": "5.3.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.1.3",
		"markdown-it": "14.3.0",
		"mdast-util-to-string": "4.0.0",
		"pagefind": "1.4.0",
		"reading-time": "1.5.0",
		"sanitize-html": "2.17.6",
		"sharp": "0.35.3",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "1.10.10",
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "1.61.1",
		"@types/markdown-it": "14.1.2",
		"@types/sanitize-html": "2.16.1",
		"only-allow": "1.2.2",
		"parse5": "7.3.0"
	},
	"packageManager": "pnpm@11.16.0"
}
