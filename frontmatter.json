{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.content.pageFolders": [
    {
      "title": "Published Fiction",
      "path": "[[workspace]]/src/content/posts/fiction",
      "previewPath": "/Shots-of-Rhapsody/posts",
      "trailingSlash": true,
      "disableCreation": true
    },
    {
      "title": "Published Non-Fiction",
      "path": "[[workspace]]/src/content/posts/nonfiction",
      "previewPath": "/Shots-of-Rhapsody/posts",
      "trailingSlash": true,
      "disableCreation": true
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": true,
      "previewPath": "/Shots-of-Rhapsody/posts",
      "trailingSlash": true,
      "filePrefix": null,
      "clearEmpty": true,
      "fields": [
        {
          "title": "title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "subtitle",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "author",
          "name": "author",
          "type": "string"
        },
        {
          "title": "published",
          "name": "published",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "preview",
          "name": "image",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "image alt text",
          "name": "imageAlt",
          "type": "string"
        },
        {
          "title": "image caption",
          "name": "imageCaption",
          "type": "string"
        },
        {
          "title": "image source URL",
          "name": "imageSourceUrl",
          "type": "string"
        },
        {
          "title": "tags",
          "name": "tags",
          "type": "list"
        },
        {
          "title": "category",
          "name": "category",
          "type": "string"
        },
        {
          "title": "draft",
          "name": "draft",
          "type": "boolean"
        },
        {
          "title": "language",
          "name": "lang",
          "type": "string"
        }
      ]
    }
  ]
}
