---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
	DISPLAY_IMAGE_QUALITY,
	type ResponsiveImageVariant,
	responsiveImageSizes,
	responsiveImageWidths,
} from "../../utils/image-policy";
import {
	isExternalImage,
	isPublicImage,
	withBasePath,
} from "../../utils/image-utils";

interface Props {
	id?: string;
	src: ImageMetadata | string;
	class?: string;
	alt?: string | null;
	position?: string;
	fit?: "cover" | "contain";
	loading?: "eager" | "lazy";
	priority?: boolean;
	variant?: ResponsiveImageVariant;
	ariaDescribedby?: string;
}

const {
	id,
	src,
	alt,
	position = "center",
	fit = "cover",
	loading = "lazy",
	priority = false,
	variant = "card",
	ariaDescribedby,
} = Astro.props;
const className = Astro.props.class;
const imageMetadata = typeof src === "string" ? undefined : src;

if (
	typeof src === "string" &&
	src.length > 0 &&
	!isPublicImage(src) &&
	!isExternalImage(src)
) {
	throw new Error(
		`Local image strings are not allowed (${src}); import the image or use the content image() schema`,
	);
}

const imageClass =
	fit === "contain"
		? "w-full h-auto object-contain"
		: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const altText = alt ?? "";
const imageUrl =
	typeof src === "string" && isPublicImage(src) ? withBasePath(src) : src;
---
<div
	id={id}
	data-image-variant={variant}
	data-source-width={imageMetadata?.width}
	data-source-height={imageMetadata?.height}
	class:list={[className, "overflow-hidden relative"]}
>
	{imageMetadata && (
		<Picture
			src={imageMetadata}
			formats={["avif"]}
			fallbackFormat="webp"
			widths={responsiveImageWidths(variant)}
			sizes={responsiveImageSizes(variant)}
			quality={DISPLAY_IMAGE_QUALITY}
			alt={altText}
			aria-describedby={ariaDescribedby}
			class={imageClass}
			style={imageStyle}
			fit={fit}
			priority={priority}
			loading={priority ? undefined : loading}
			decoding="async"
		/>
	)}
	{typeof imageUrl === "string" && imageUrl.length > 0 && (
		<img
			src={imageUrl}
			alt={altText}
			aria-describedby={ariaDescribedby}
			class={imageClass}
			style={imageStyle}
			loading={priority ? "eager" : loading}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
		/>
	)}
</div>
