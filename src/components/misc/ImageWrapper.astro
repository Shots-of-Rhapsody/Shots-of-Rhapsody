---
interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string | null;
	position?: string;
	basePath?: string;
	fit?: "cover" | "contain";
	loading?: "eager" | "lazy";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";
import {
	isExternalImage,
	isPublicImage,
	loadLocalImage,
} from "../../utils/image-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	fit = "cover",
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

const isLocal = !isPublicImage(src) && !isExternalImage(src);
const isPublic = isPublicImage(src);
const img = isLocal ? await loadLocalImage(src, basePath) : undefined;

const imageClass = fit === "contain"
	? "w-full h-auto object-contain"
	: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const altText = alt ?? "";
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={altText} class={imageClass} style={imageStyle} loading={loading}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={altText} class={imageClass} style={imageStyle} loading={loading} decoding="async"/>}
</div>
