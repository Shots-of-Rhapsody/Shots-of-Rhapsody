---
interface Props {
	class?: string;
	archiveBody?: boolean;
	searchable?: boolean;
}

const className = Astro.props.class;
const { archiveBody = false, searchable = true } = Astro.props;
---

<div
	data-pagefind-body={searchable ? "" : undefined}
	data-archive-body={archiveBody ? "" : undefined}
	class:list={["prose dark:prose-invert custom-md", className]}
>
	<slot />
</div>
