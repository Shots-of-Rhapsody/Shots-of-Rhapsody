---
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	pubDate: Date;
	author?: string;
	license?: {
		name: string;
		url?: string;
	};
	canonicalUrl: string;
	class?: string;
}

const { title, pubDate, author, license, canonicalUrl } = Astro.props;
const className = Astro.props.class;
const authorName = author || profileConfig.name;
const licenseDetails = license ?? licenseConfig;
const isCreativeCommons = licenseDetails.name
	.toLowerCase()
	.includes("creative commons");
---
<div data-license-name={licenseDetails.name} class={`relative transition overflow-hidden bg-[var(--license-block-bg)] py-5 px-6 ${className}`}>
    <div class="transition font-bold text-black/75 dark:text-white/75">
        {title}
    </div>
    <a href={canonicalUrl} class="link text-[var(--primary)]">
        {canonicalUrl}
    </a>
    <div class="flex flex-wrap gap-6 mt-2">
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.author)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{authorName}</div>
        </div>
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.publishedAt)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{formatDateToYYYYMMDD(pubDate)}</div>
        </div>
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.license)}</div>
			{licenseDetails.url ? (
				<a href={licenseDetails.url} target="_blank" rel="noopener noreferrer" class="link text-[var(--primary)] line-clamp-2">{licenseDetails.name}</a>
			) : (
				<div class="transition text-black/75 dark:text-white/75 line-clamp-2">{licenseDetails.name}</div>
			)}
        </div>
    </div>
    <Icon name={isCreativeCommons ? "fa6-brands:creative-commons" : "material-symbols:copyright-rounded"} class="transition text-[15rem] absolute pointer-events-none right-6 top-1/2 -translate-y-1/2 text-black/5 dark:text-white/5"></Icon>
</div>
