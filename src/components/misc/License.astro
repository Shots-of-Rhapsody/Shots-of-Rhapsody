---
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { licenseConfig, profileConfig } from "@/config";

interface Props {
	title: string;
	pubDate: Date;
	author?: string;
	license?: { name: string; url?: string };
	class?: string;
}

const { title, pubDate, author, license } = Astro.props;
const className = Astro.props.class;
const authorName = author || profileConfig.name;
const licenseDetails = license ?? licenseConfig;
---

<aside data-license-name={licenseDetails.name} class:list={["rights-note", className]}>
	<p class="rights-note__label">Publication and rights</p>
	<p><strong>{title}</strong> by {authorName}</p>
	<p>
		Published <time datetime={pubDate.toISOString()} data-license-published>{formatDateToYYYYMMDD(pubDate)}</time>
		· {licenseDetails.url ? (
			<a href={licenseDetails.url} rel="noopener noreferrer">{licenseDetails.name}</a>
		) : licenseDetails.name}
	</p>
</aside>

<style>
	.rights-note {
		max-width: 66ch;
		margin-inline: auto;
		border-inline-start: 3px solid var(--seal);
		background: var(--license-block-bg);
		padding: 1rem 1.2rem;
		color: var(--ink-soft);
		font-size: 0.76rem;
	}

	.rights-note p {
		margin: 0.15rem 0;
	}

	.rights-note__label {
		color: var(--seal);
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.rights-note a {
		color: var(--celadon);
	}

</style>
