---
import { getCollection } from "astro:content";
import { url } from "@utils/url-utils";
import { getVisiblePodcastEpisodes } from "@/data/podcast-approval";
import Search from "./Search.astro";

const posts = await getCollection("posts");
const hasNonfiction = posts.some(
	(entry) => entry.data.section === "nonfiction",
);
const hasPodcast = getVisiblePodcastEpisodes().length > 0;
const links = [
	{ label: "Works", href: url("/archive/") },
	...(hasNonfiction
		? [{ label: "Nonfiction", href: url("/nonfiction/") }]
		: []),
	...(hasPodcast ? [{ label: "Podcast", href: url("/podcast/") }] : []),
	{ label: "About", href: url("/about/") },
];
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="brand" href={url("/")} aria-label="Shots of Rhapsody home">
			<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
				<rect x="3" y="3" width="42" height="42" rx="4" />
				<path d="M14 17c3-5 13-5 17-1-4-1-9 0-10 3-1 4 11 2 11 11 0 7-8 10-16 6 5 0 10-2 10-6 0-5-12-2-12-11 0-.7 0-1.3.2-2Z" />
				<path d="M32 14v22" />
			</svg>
			<span><strong>Shots of Rhapsody</strong><small>Stories · poems · reflections</small></span>
		</a>

		<div class="nav-links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>

		<div class="nav-actions">
			<Search />
			<button id="scheme-switch" class="icon-button" type="button" aria-label="Switch theme" aria-pressed="false" title="Switch theme">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.4 0-.8-.1-1.2A7 7 0 0 1 12 3Z" /></svg>
			</button>
			<button id="nav-menu-switch" class="icon-button mobile-menu-button" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu-panel">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			</button>
		</div>

		<div id="nav-menu-panel" class="mobile-menu float-panel-closed">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
	</nav>
</header>

<script>
	const themeButton = document.querySelector<HTMLButtonElement>("#scheme-switch");
	const syncThemeControl = () => {
		const dark = document.documentElement.classList.contains("dark");
		const action = dark ? "Switch to light theme" : "Switch to dark theme";
		themeButton?.setAttribute("aria-pressed", String(dark));
		themeButton?.setAttribute("aria-label", action);
		if (themeButton) themeButton.title = action;
	};
	const applyTheme = (dark: boolean) => {
		document.documentElement.classList.toggle("dark", dark);
		document.documentElement.dataset.theme = dark ? "dark" : "light";
		localStorage.setItem("theme", dark ? "dark" : "light");
		syncThemeControl();
	};
	themeButton?.addEventListener("click", () => applyTheme(!document.documentElement.classList.contains("dark")));
	syncThemeControl();

	const menuButton = document.querySelector<HTMLButtonElement>("#nav-menu-switch");
	const menu = document.querySelector<HTMLElement>("#nav-menu-panel");
	const setMenuOpen = (open: boolean) => {
		menu?.classList.toggle("float-panel-closed", !open);
		menuButton?.setAttribute("aria-expanded", String(open));
	};
	menuButton?.addEventListener("click", () => {
		const opening = menu?.classList.contains("float-panel-closed") ?? false;
		setMenuOpen(opening);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape" || menu?.classList.contains("float-panel-closed")) return;
		setMenuOpen(false);
		menuButton?.focus();
	});
	document.addEventListener("click", (event) => {
		if (
			menu?.classList.contains("float-panel-closed") ||
			menu?.contains(event.target as Node) ||
			menuButton?.contains(event.target as Node)
		) {
			return;
		}
		setMenuOpen(false);
	});
</script>
