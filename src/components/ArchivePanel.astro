---
import type { PostForList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	sortedPosts: PostForList[];
}

const { sortedPosts } = Astro.props;
const groups = new Map<string, PostForList[]>();
for (const post of sortedPosts) {
	const year = formatDateToYYYYMMDD(post.data.published).slice(0, 4);
	const group = groups.get(year) ?? [];
	group.push(post);
	groups.set(year, group);
}
---

<section class="archive-sheet" aria-labelledby="archive-title">
	<header class="archive-heading">
		<p class="eyebrow">The complete collection</p>
		<h1 id="archive-title">Works</h1>
		<p>Eleven stories, poems, and reflections, arranged by original publication date.</p>
	</header>
	<div data-archive-entry-index>
		{[...groups].map(([year, posts]) => (
			<section class="archive-year" aria-labelledby={`year-${year}`}>
				<header>
					<h2 id={`year-${year}`}>{year}</h2>
					<span>{posts.length} {posts.length === 1 ? "work" : "works"}</span>
				</header>
				<ol>
					{posts.map((post) => (
						<li
							data-category={post.data.category ?? ""}
							data-tags={JSON.stringify(post.data.tags)}
						>
							<a
								href={getPostUrlBySlug(post.slug)}
								data-archive-entry-slug={post.slug}
							>
								<time
									datetime={post.data.published.toISOString()}
									data-archive-published
								>
									{formatDateToYYYYMMDD(post.data.published).slice(5)}
								</time>
								<strong>{post.data.title}</strong>
								<span>{post.data.category}</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		))}
	</div>
</section>

<style>
	.archive-sheet {
		max-width: 64rem;
		margin-inline: auto;
		border: 1px solid var(--rule);
		border-radius: 0.5rem;
		background: var(--paper-raised);
		box-shadow: var(--shadow);
		padding: clamp(1.4rem, 4vw, 3.2rem);
	}

	.archive-heading {
		max-width: 46rem;
		margin-bottom: 2.5rem;
	}

	.eyebrow {
		margin: 0 0 0.3rem;
		color: var(--seal);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	h1,
	h2,
	strong {
		font-family: "Noto Serif Variable", Georgia, serif;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 7vw, 4.5rem);
		font-weight: 670;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.archive-heading > p:last-child {
		color: var(--ink-soft);
	}

	.archive-year > header {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		border-bottom: 1px solid var(--rule);
		padding-bottom: 0.55rem;
	}

	.archive-year h2 {
		margin: 0;
		color: var(--celadon);
		font-size: 1.55rem;
		font-weight: 660;
	}

	.archive-year header span {
		color: var(--ink-soft);
		font-size: 0.75rem;
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li + li {
		border-top: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
	}

	li a {
		display: grid;
		min-height: 4.5rem;
		grid-template-columns: 4rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 0.35rem;
		text-decoration: none;
	}

	li a:hover {
		background: color-mix(in srgb, var(--celadon-soft) 54%, transparent);
	}

	time,
	li a > span {
		color: var(--ink-soft);
		font-size: 0.76rem;
	}

	strong {
		min-width: 0;
		font-size: clamp(1rem, 1.7vw, 1.17rem);
		font-weight: 580;
	}

	@media (max-width: 580px) {
		li a {
			grid-template-columns: 3.35rem minmax(0, 1fr);
			gap: 0.65rem;
		}

		li a > span {
			display: none;
		}
	}
</style>

<script>
	const params = new URLSearchParams(window.location.search);
	const selectedTags = params.getAll("tag");
	const selectedCategories = params.getAll("category");
	const uncategorized = params.get("uncategorized") === "true";

	if (selectedTags.length || selectedCategories.length || uncategorized) {
		for (const item of document.querySelectorAll<HTMLElement>(".archive-year li")) {
			const tags = JSON.parse(item.dataset.tags ?? "[]") as string[];
			const category = item.dataset.category ?? "";
			const tagMatch = !selectedTags.length || tags.some((tag) => selectedTags.includes(tag));
			const categoryMatch =
				!selectedCategories.length || selectedCategories.includes(category);
			item.hidden = !(tagMatch && categoryMatch && (!uncategorized || !category));
		}

		for (const section of document.querySelectorAll<HTMLElement>(".archive-year")) {
			const visible = [...section.querySelectorAll("li")].filter((item) => !item.hidden);
			section.hidden = visible.length === 0;
			const count = section.querySelector("header span");
			if (count) count.textContent = `${visible.length} ${visible.length === 1 ? "work" : "works"}`;
		}
	}
</script>
