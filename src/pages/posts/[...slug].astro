---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getAbsoluteImageUrl } from "@utils/image-utils";
import {
	getAbsolutePostUrlBySlug,
	getDir,
	getPostUrlBySlug,
	getSiteRootUrl,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { licenseConfig, profileConfig, siteConfig } from "../../config";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const siteUrl = Astro.site ?? Astro.url;
const siteRoot = getSiteRootUrl(siteUrl);
const postBasePath = path.join("content/posts/", getDir(entry.id));
const canonicalUrl = getAbsolutePostUrlBySlug(entry.slug, siteUrl).toString();
const author = entry.data.author || profileConfig.name;
const description =
	entry.data.description ||
	entry.data.subtitle ||
	entry.data.summary ||
	entry.data.title;
const coverUrl = entry.data.image
	? await getAbsoluteImageUrl(entry.data.image, postBasePath, siteUrl)
	: undefined;
const isArchivePost = Boolean(entry.data.provenance);
const coverAlt = isArchivePost
	? (entry.data.imageAlt ?? "")
	: (entry.data.imageAlt ?? `Cover image for “${entry.data.title}”`);
const imageDescription = isArchivePost
	? (entry.data.imageAlt ?? undefined)
	: coverAlt;
const archiveWordCount = entry.data.provenance?.wordCount;
const displayedWordCount = archiveWordCount ?? remarkPluginFrontmatter.words;
const displayedMinutes =
	archiveWordCount !== undefined
		? Math.max(1, Math.round(archiveWordCount / 200))
		: remarkPluginFrontmatter.minutes;
const showLicense = Boolean(entry.data.license) || licenseConfig.enable;
const effectiveLicense =
	entry.data.license ?? (licenseConfig.enable ? licenseConfig : undefined);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${canonicalUrl}#article`,
	headline: entry.data.title,
	alternativeHeadline: entry.data.subtitle || undefined,
	description,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: author,
	},
	publisher: {
		"@type": "Organization",
		"@id": `${siteRoot}#organization`,
		name: siteConfig.title,
		url: siteRoot.toString(),
	},
	datePublished: entry.data.published.toISOString(),
	dateModified: entry.data.updated?.toISOString(),
	url: canonicalUrl,
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalUrl,
	},
	image: coverUrl
		? {
				"@type": "ImageObject",
				url: coverUrl,
				contentUrl: coverUrl,
				description: imageDescription,
				caption: entry.data.imageCaption || undefined,
			}
		: undefined,
	isBasedOn: entry.data.publication?.url,
	articleSection: entry.data.category || undefined,
	wordCount: displayedWordCount,
	license: effectiveLicense?.url ?? effectiveLicense?.name,
	copyrightNotice: effectiveLicense?.name,
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---
<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	headings={headings}
	canonicalUrl={canonicalUrl}
	socialImage={coverUrl}
	socialImageAlt={coverAlt}
	author={author}
	published={entry.data.published}
	updated={entry.data.updated}
	tags={entry.data.tags}
	category={entry.data.category}
>
    <script is:inline slot="head" type="application/ld+json" set:html={jsonLdString}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{displayedWordCount} {" " + i18n(displayedWordCount === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {displayedMinutes} {" " + i18n(displayedMinutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
					data-archive-field={isArchivePost ? "title" : undefined}
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </h1>
				{entry.data.subtitle && <p data-archive-field={isArchivePost ? "subtitle" : undefined} class="transition text-lg md:text-xl text-black/65 dark:text-white/65 mb-3">{entry.data.subtitle}</p>}
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-black/50 dark:text-white/50 mb-4" data-pagefind-ignore>
					<span data-archive-field={isArchivePost ? "author" : undefined}>By {author}</span>
					{entry.data.publication && <span aria-hidden="true">·</span>}
					{entry.data.publication && <a data-archive-publication-url href={entry.data.publication.url} target="_blank" rel="noopener noreferrer" class="link text-[var(--primary)]">Originally published on {entry.data.publication.platform}</a>}
				</div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

			{entry.data.image && <figure data-archive-hero={isArchivePost ? "" : undefined} class="mb-8 onload-animation">
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					basePath={postBasePath}
					alt={coverAlt}
					fit="contain"
					loading="eager"
					class="rounded-xl banner-container bg-black/5 dark:bg-white/5"
				/>
				{entry.data.imageCaption && <figcaption data-archive-field={isArchivePost ? "image-caption" : undefined} class="mt-2 px-2 text-sm text-center text-black/50 dark:text-white/50">{entry.data.imageCaption}</figcaption>}
			</figure>}


            <Markdown archiveBody={isArchivePost} class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {showLicense && <License
				title={entry.data.title}
				pubDate={entry.data.published}
				author={author}
				license={entry.data.license}
				canonicalUrl={canonicalUrl}
				class="mb-6 rounded-xl license-container onload-animation"
			></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>
