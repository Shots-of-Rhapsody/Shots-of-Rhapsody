---
import { render } from "astro:content";
import EditorialWorkCard from "@components/EditorialWorkCard.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	getPostDeck,
	getPostHeadline,
	getSortedPosts,
} from "@utils/content-utils";
import { getSocialImage } from "@utils/image-utils";
import {
	getAbsolutePostUrlBySlug,
	getSiteRootUrl,
	url,
} from "@utils/url-utils";
import {
	EDITORIAL_METADATA,
	getWritingTypeLabel,
	indexEditorialEntries,
	isManifestSlug,
} from "@/data/editorial";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { licenseConfig, profileConfig, siteConfig } from "../../config";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const indexedEntries = indexEditorialEntries(blogEntries);
	const nonfictionEntries = blogEntries
		.filter((entry) => entry.data.section === "nonfiction")
		.toSorted(
			(left, right) =>
				left.data.published.valueOf() - right.data.published.valueOf(),
		);
	const nonfictionContinuation = new Map(
		nonfictionEntries.map((entry, index) => [
			entry.id,
			nonfictionEntries[index + 1],
		]),
	);
	return blogEntries.map((entry) => ({
		params: { slug: entry.id },
		props: {
			entry,
			continuationEntry: isManifestSlug(entry.id)
				? indexedEntries.get(EDITORIAL_METADATA[entry.id].continueSlug)
				: nonfictionContinuation.get(entry.id),
			returnToNonfiction:
				entry.data.section === "nonfiction" &&
				!nonfictionContinuation.get(entry.id),
		},
	}));
}

const { entry, continuationEntry, returnToNonfiction } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const headline = getPostHeadline(entry);
const deck = getPostDeck(entry);
const siteUrl = Astro.site ?? Astro.url;
const siteRoot = getSiteRootUrl(siteUrl);
const canonicalUrl = getAbsolutePostUrlBySlug(entry.id, siteUrl).toString();
const author = entry.data.author || profileConfig.name;
const description = entry.data.description || deck;
const socialImage = getSocialImage(entry.id, siteUrl);
const coverUrl = socialImage.url;
const isSourceVerifiedPost = Boolean(entry.data.provenance);
const isSealedArchivePost = entry.data.provenance?.authority === "Proton Docs";
const isMediumPost =
	entry.data.provenance?.authority === "Medium account export";
const authorUrl =
	author === "Tai Song"
		? new URL(url("/authors/tai-song/"), siteUrl).toString()
		: undefined;
const coverAlt = isSourceVerifiedPost
	? (entry.data.imageAlt ?? "")
	: (entry.data.imageAlt ?? `Cover image for “${headline}”`);
const imageDescription = isSourceVerifiedPost
	? (entry.data.imageAlt ?? undefined)
	: coverAlt;
const archiveWordCount = entry.data.provenance?.wordCount;
const displayedWordCount = archiveWordCount ?? remarkPluginFrontmatter.words;
const displayedMinutes =
	archiveWordCount !== undefined
		? Math.max(1, Math.round(archiveWordCount / 200))
		: remarkPluginFrontmatter.minutes;
const writingType = getWritingTypeLabel(entry.id, entry.data.category ?? "");
const showLicense = Boolean(entry.data.license) || licenseConfig.enable;
const effectiveLicense =
	entry.data.license ?? (licenseConfig.enable ? licenseConfig : undefined);
const coverCaptionId =
	isSourceVerifiedPost && entry.data.imageCaption
		? `hero-caption-${entry.id}`
		: undefined;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${canonicalUrl}#article`,
	headline,
	alternativeHeadline: isMediumPost
		? entry.data.title
		: entry.data.subtitle || undefined,
	description,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: author,
		url: authorUrl,
		"@id": authorUrl ? `${authorUrl}#person` : undefined,
	},
	publisher: {
		"@type": "Organization",
		"@id": `${siteRoot}#organization`,
		name: siteConfig.title,
		url: siteRoot.toString(),
	},
	datePublished: entry.data.published.toISOString(),
	dateModified: entry.data.updated?.toISOString(),
	url: canonicalUrl,
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalUrl,
	},
	image: {
		"@type": "ImageObject",
		url: coverUrl,
		contentUrl: coverUrl,
		encodingFormat: socialImage.mimeType,
		width: socialImage.width,
		height: socialImage.height,
		description: imageDescription,
		caption: entry.data.imageCaption || undefined,
	},
	articleSection: entry.data.category || undefined,
	wordCount: displayedWordCount,
	license: effectiveLicense?.url ?? effectiveLicense?.name,
	copyrightNotice: effectiveLicense?.name,
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---
<MainGridLayout
	title={headline}
	description={description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	headings={headings}
	canonicalUrl={canonicalUrl}
	socialImage={coverUrl}
	socialImageAlt={coverAlt}
	socialImageWidth={socialImage.width}
	socialImageHeight={socialImage.height}
	socialImageType={socialImage.mimeType}
	author={author}
	published={entry.data.published}
	updated={entry.data.updated}
	tags={entry.data.tags}
	category={entry.data.category}
>
	<script is:inline slot="head" type="application/ld+json" set:html={jsonLdString}></script>
	<article id="post-container" class="article-shell">
		<header class="article-header">
			<p class="article-type" data-pagefind-meta="type">{writingType}</p>
			<div class="post-reading-meta" data-pagefind-ignore>
				<span>{displayedWordCount} {displayedWordCount === 1 ? "word" : "words"}</span>
				<span aria-hidden="true">·</span>
				<span>{displayedMinutes} min read</span>
			</div>
			<h1
				data-pagefind-body
				data-pagefind-weight="10"
				data-pagefind-meta="title"
				data-archive-field={isSealedArchivePost ? "title" : undefined}
				data-medium-field={isMediumPost ? "export-title" : undefined}
			>
				{headline}
			</h1>
			{(isMediumPost ? deck : entry.data.subtitle) && (
				<p
					data-archive-field={isSealedArchivePost ? "subtitle" : undefined}
					data-medium-field={isMediumPost ? "summary" : undefined}
					class="article-subtitle"
				>
					{isMediumPost ? deck : entry.data.subtitle}
				</p>
			)}
			<div class="article-byline" data-pagefind-ignore>
				<span
					data-archive-field={isSealedArchivePost ? "author" : undefined}
					data-medium-field={isMediumPost ? "author" : undefined}
				>
					By {authorUrl ? <a href={url("/authors/tai-song/")}>{author}</a> : author}
				</span>
			</div>
			<div class="article-metadata" data-pagefind-ignore>
				<PostMetadata
					published={entry.data.published}
					updated={entry.data.updated}
					tags={entry.data.tags}
					category={entry.data.category}
				/>
			</div>
		</header>

		{isMediumPost && (
			<section class="article-medium-lead" data-medium-lead>
				<h2 data-medium-field="title">{entry.data.title}</h2>
				<p data-medium-field="subtitle">{entry.data.subtitle}</p>
			</section>
		)}

		{entry.data.seriesLine && (
			<p
				class="article-series-line"
				data-medium-field={isMediumPost ? "series-line" : undefined}
			>
				{entry.data.seriesLine}
			</p>
		)}

		{entry.data.image && (
			<figure
				data-archive-hero={isSealedArchivePost ? "" : undefined}
				data-medium-hero={isMediumPost ? "" : undefined}
				class="article-hero"
			>
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					variant="hero"
					priority
					alt={coverAlt}
					ariaDescribedby={coverCaptionId}
					fit="contain"
					class="article-hero__image"
				/>
				{entry.data.imageCaption && (
					<figcaption
						id={coverCaptionId}
						data-archive-field={isSealedArchivePost ? "image-caption" : undefined}
						class="article-caption"
					>
						{entry.data.imageCaption}
					</figcaption>
				)}
			</figure>
		)}

		<Markdown archiveBody={isSealedArchivePost} class="article-body markdown-content">
			<Content />
		</Markdown>

		{continuationEntry && (
			<section
				class="post-continuation"
				aria-labelledby="continue-reading-title"
				data-editorial-continuation-from={entry.id}
				data-editorial-continue-slug={continuationEntry.id}
				data-pagefind-ignore
			>
				<p class="post-continuation__kicker">The next leaf</p>
				<h2 id="continue-reading-title">Continue through the archive</h2>
				<EditorialWorkCard
					entry={continuationEntry}
					variant="continuation"
					context="article"
				/>
			</section>
		)}
		{returnToNonfiction && (
			<nav class="post-continuation post-continuation--index" aria-label="Continue reading" data-pagefind-ignore>
				<p class="post-continuation__kicker">More essays</p>
				<a href={url("/nonfiction/")}>Return to the Nonfiction collection <span aria-hidden="true">→</span></a>
			</nav>
		)}

		{showLicense && (
			<License
				title={headline}
				pubDate={entry.data.published}
				author={author}
				license={entry.data.license}
				class="license-container"
			/>
		)}
	</article>
</MainGridLayout>

<style>
	.article-shell {
		width: 100%;
		padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem);
		background: var(--card-bg);
		border-block: 1px solid var(--line-divider);
	}

	.article-header {
		max-width: 66ch;
		margin-inline: auto;
		padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line-divider);
	}

	.article-medium-lead {
		max-width: 66ch;
		margin: clamp(2rem, 5vw, 3.5rem) auto 0;
		padding-inline: clamp(0rem, 2vw, 1rem);
	}

	.article-medium-lead h2 {
		margin: 0;
		color: var(--title-color);
		font-size: clamp(1.65rem, 4vw, 2.65rem);
		font-weight: 620;
		letter-spacing: -0.015em;
		line-height: 1.12;
		text-wrap: balance;
	}

	.article-medium-lead p {
		margin: 0.8rem 0 0;
		color: var(--ink-soft);
		font-size: clamp(1.02rem, 2vw, 1.2rem);
		line-height: 1.6;
	}

	.article-header h1 {
		margin: 0;
		color: var(--title-color);
		font-size: clamp(2.15rem, 6vw, 4.65rem);
		font-weight: 640;
		letter-spacing: -0.025em;
		line-height: 1.03;
		text-wrap: balance;
	}

	.article-type {
		margin: 0 0 0.5rem;
		color: var(--primary);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.article-subtitle {
		margin: 1rem 0 0;
		color: var(--ink-soft);
		font-size: clamp(1.08rem, 2.2vw, 1.35rem);
		line-height: 1.55;
	}

	.post-reading-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.15rem;
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	.article-byline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		margin-top: 1rem;
		color: var(--ink-soft);
		font-size: 0.82rem;
	}

	.article-byline a {
		color: var(--primary);
		font-weight: 700;
		text-underline-offset: 0.2em;
	}

	.article-metadata {
		margin-top: 0.7rem;
	}

	.article-series-line {
		max-width: 66ch;
		margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
		padding-inline-start: 1rem;
		border-inline-start: 2px solid var(--primary);
		color: var(--ink-soft);
		font-size: clamp(1rem, 1.8vw, 1.12rem);
		font-style: italic;
		line-height: 1.65;
	}

	.article-hero {
		max-width: 71rem;
		margin: clamp(2rem, 5vw, 3.5rem) auto;
	}

	.article-hero__image {
		background: color-mix(in srgb, var(--primary) 5%, transparent);
		border-block: 1px solid var(--line-divider);
	}

	.article-caption {
		margin-top: 0.55rem;
		padding-inline: 0.75rem;
		color: var(--ink-soft);
		font-size: 0.82rem;
		text-align: center;
	}

	.article-body {
		margin-inline: auto;
	}

	.post-continuation {
		display: grid;
		gap: 1rem;
		max-width: 66ch;
		margin: clamp(3rem, 8vw, 5rem) auto 2rem;
		padding-top: clamp(1.5rem, 4vw, 2.5rem);
		border-top: 1px solid var(--line-divider);
	}

	.post-continuation__kicker {
		margin: 0;
		color: var(--primary);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.post-continuation h2 {
		margin: -0.45rem 0 0.25rem;
		font-size: clamp(1.55rem, 4vw, 2.35rem);
		font-weight: 620;
		line-height: 1.15;
	}

	.post-continuation--index a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.5rem;
		color: var(--primary);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-weight: 700;
	}

	@media (max-width: 42rem) {
		.article-shell {
			padding-inline: 0.75rem;
		}
	}
</style>
