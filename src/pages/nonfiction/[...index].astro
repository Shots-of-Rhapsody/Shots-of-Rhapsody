---
import { type CollectionEntry, getCollection } from "astro:content";
import EditorialWorkCard from "@components/EditorialWorkCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getAbsolutePostUrlBySlug, url } from "@utils/url-utils";

interface Props {
	entries: CollectionEntry<"posts">[];
}

export async function getStaticPaths() {
	const entries = (await getCollection("posts"))
		.filter((entry) => entry.data.section === "nonfiction")
		.toSorted(
			(left, right) =>
				right.data.published.valueOf() - left.data.published.valueOf(),
		);
	return entries.length === 0
		? []
		: [{ params: { index: undefined }, props: { entries } }];
}

const { entries } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(url("/nonfiction/"), siteUrl).toString();
const description =
	"Nonfiction by Tai Song, preserved from author-approved sources and reviewed claim by claim.";
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"@id": `${canonicalUrl}#collection`,
	name: "Nonfiction — Shots of Rhapsody",
	description,
	url: canonicalUrl,
	inLanguage: "en",
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: entries.length,
		itemListElement: entries.map((entry, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: entry.data.title,
			url: getAbsolutePostUrlBySlug(entry.id, siteUrl).toString(),
		})),
	},
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<MainGridLayout title="Nonfiction" description={description} canonicalUrl={canonicalUrl}>
	<script is:inline slot="head" type="application/ld+json" set:html={jsonLdString}></script>
	<main class="nonfiction-page">
		<header class="nonfiction-heading manuscript-panel">
			<p class="nonfiction-kicker">Essays and inquiry</p>
			<h1>Nonfiction</h1>
			<p>{description}</p>
		</header>
		<div class="nonfiction-list" data-nonfiction-index>
			{entries.map((entry) => (
				<EditorialWorkCard entry={entry} variant="catalog" label="Nonfiction" />
			))}
		</div>
	</main>
</MainGridLayout>

<style>
	.nonfiction-page,
	.nonfiction-list {
		display: grid;
		gap: clamp(1.25rem, 4vw, 2.5rem);
	}

	.nonfiction-heading {
		padding: clamp(2rem, 7vw, 5rem);
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
	}

	.nonfiction-kicker {
		margin: 0 0 0.65rem;
		color: var(--primary);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.nonfiction-heading h1 {
		margin: 0;
		font-size: clamp(2.7rem, 8vw, 5.5rem);
		font-weight: 620;
		line-height: 1;
	}

	.nonfiction-heading > p:last-child {
		max-width: 56ch;
		margin: 1.5rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
		opacity: 0.76;
	}
</style>
