---
import { getCollection } from "astro:content";
import EditorialWorkCard from "@components/EditorialWorkCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	getAbsolutePostUrlBySlug,
	getPostUrlBySlug,
	url,
} from "@utils/url-utils";
import { siteConfig } from "@/config";
import {
	EDITORIAL_GROUPS,
	entriesForSlugs,
	getFeaturedEntries,
	indexEditorialEntries,
	isManifestSlug,
} from "@/data/editorial";

const archiveEntries = await getCollection("posts");
const indexedEntries = indexEditorialEntries(archiveEntries);
const featuredEntries = getFeaturedEntries(indexedEntries);
const groups = EDITORIAL_GROUPS.map((group) => ({
	...group,
	entries: entriesForSlugs(indexedEntries, group.slugs),
}));
const nonfictionEntries = archiveEntries
	.filter((entry) => entry.data.section === "nonfiction")
	.toSorted(
		(left, right) =>
			right.data.published.valueOf() - left.data.published.valueOf(),
	);
const additionalCreativeEntries = archiveEntries
	.filter(
		(entry) => !isManifestSlug(entry.id) && entry.data.section !== "nonfiction",
	)
	.toSorted(
		(left, right) =>
			right.data.published.valueOf() - left.data.published.valueOf(),
	);
const articles = [
	...groups.flatMap((group) => group.entries),
	...additionalCreativeEntries,
	...nonfictionEntries,
];

const siteUrl = Astro.site ?? Astro.url;
const authorUrl = new URL(url("/authors/tai-song/"), siteUrl).toString();
const authorBio =
	"Tai Song is a Singapore-based commodity trader and trade strategist whose writing spans fiction, poetry, reflection, and nonfiction. Across global markets and imagined futures, Tai explores power, policy, inequality, memory, the consequences of invention, and the fragile things people try to preserve.";
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": `${authorUrl}#profile`,
	name: "Tai Song — Shots of Rhapsody",
	description: authorBio,
	url: authorUrl,
	inLanguage: "en",
	mainEntity: {
		"@type": "Person",
		"@id": `${authorUrl}#person`,
		name: "Tai Song",
		description: authorBio,
		url: authorUrl,
		mainEntityOfPage: {
			"@id": `${authorUrl}#profile`,
		},
		workExample: articles.map((entry) => ({
			"@type": "CreativeWork",
			name: entry.data.title,
			url: getAbsolutePostUrlBySlug(entry.id, siteUrl).toString(),
		})),
	},
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<MainGridLayout
	title="Tai Song"
	description="Stories, poems, reflections, and nonfiction by Tai Song."
	canonicalUrl={authorUrl}
>
	<script is:inline slot="head" type="application/ld+json" set:html={jsonLdString}></script>
	<article data-author-archive="Tai Song" class="author-page">
		<header class="author-intro manuscript-panel">
			<p class="author-intro__kicker">Author</p>
			<h1>Tai Song</h1>
			<p>{authorBio}</p>
		</header>

		<nav class="author-start" aria-labelledby="author-start-title">
			<div>
				<p class="author-intro__kicker">Three entrances</p>
				<h2 id="author-start-title">Start here</h2>
			</div>
			<ol>
				{featuredEntries.map((entry) => (
					<li>
						<a href={getPostUrlBySlug(entry.id)}>
							<span>{entry.data.title}</span>
							<span aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ol>
		</nav>

		<section class="author-works" aria-labelledby="author-works-title" data-pagefind-ignore>
			<header class="author-works__heading">
				<p class="author-intro__kicker">Complete archive</p>
				<h2 id="author-works-title">
					{articles.length === 11 ? "All eleven works" : `All ${articles.length} works`}
				</h2>
			</header>

			<div class="author-groups">
				{groups.map((group) => (
					<section class="author-group" aria-labelledby={`author-group-${group.id}`}>
						<header>
							<h3 id={`author-group-${group.id}`}>{group.title}</h3>
							<p>{group.description}</p>
						</header>
						<div class="author-group__cards">
							{group.entries.map((entry) => (
								<EditorialWorkCard
									entry={entry}
									variant="catalog"
									context="author"
								/>
							))}
						</div>
					</section>
				))}
				{additionalCreativeEntries.length > 0 && (
					<section class="author-group" aria-labelledby="author-group-new-writing">
						<header>
							<h3 id="author-group-new-writing">New writing</h3>
							<p>Recently published stories and reflections.</p>
						</header>
						<div class="author-group__cards">
							{additionalCreativeEntries.map((entry) => (
								<EditorialWorkCard entry={entry} variant="catalog" context="author" />
							))}
						</div>
					</section>
				)}
				{nonfictionEntries.length > 0 && (
					<section class="author-group" aria-labelledby="author-group-nonfiction">
						<header>
							<h3 id="author-group-nonfiction">Nonfiction</h3>
							<p>{siteConfig.nonfictionDescription}</p>
						</header>
						<div class="author-group__cards">
							{nonfictionEntries.map((entry) => (
								<EditorialWorkCard entry={entry} variant="catalog" context="author" label="Nonfiction" />
							))}
						</div>
					</section>
				)}
			</div>
		</section>
	</article>
</MainGridLayout>

<style>
	.author-page,
	.author-works,
	.author-groups,
	.author-group,
	.author-group__cards {
		display: grid;
	}

	.author-page {
		gap: clamp(2.75rem, 7vw, 5.5rem);
	}

	.manuscript-panel {
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
	}

	.author-intro {
		padding: clamp(2rem, 7vw, 5rem);
	}

	.author-intro__kicker {
		margin: 0 0 0.65rem;
		color: var(--primary);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.author-intro h1 {
		margin: 0;
		font-size: clamp(2.7rem, 8vw, 5.5rem);
		font-weight: 620;
		line-height: 1;
	}

	.author-intro > p:last-child {
		max-width: 56ch;
		margin: 1.5rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
		opacity: 0.76;
	}

	.author-start {
		display: grid;
		grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	.author-start h2,
	.author-works h2,
	.author-group h3 {
		margin: 0;
		font-weight: 620;
		line-height: 1.15;
	}

	.author-start h2,
	.author-works h2 {
		font-size: clamp(1.8rem, 5vw, 3rem);
	}

	.author-start ol {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line-divider);
	}

	.author-start li {
		border-bottom: 1px solid var(--line-divider);
	}

	.author-start a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.5rem;
		padding: 0.8rem 0.2rem;
		color: inherit;
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 620;
		text-decoration: none;
	}

	.author-start a:hover,
	.author-start a:focus-visible {
		color: var(--primary);
	}

	.author-start a:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
	}

	.author-works,
	.author-groups,
	.author-group,
	.author-group__cards {
		gap: clamp(1.25rem, 3vw, 2rem);
	}

	.author-groups {
		gap: clamp(2.5rem, 6vw, 4.5rem);
	}

	.author-group {
		grid-template-columns: minmax(11rem, 0.32fr) minmax(0, 1fr);
		align-items: start;
		padding-top: 2rem;
		border-top: 1px solid var(--line-divider);
	}

	.author-group h3 {
		font-size: clamp(1.3rem, 3vw, 1.85rem);
	}

	.author-group header p {
		max-width: 34ch;
		margin: 0.7rem 0 0;
		line-height: 1.6;
		opacity: 0.65;
	}

	.author-group__cards {
		gap: 0.85rem;
	}

	@media (max-width: 48rem) {
		.author-start,
		.author-group {
			grid-template-columns: 1fr;
		}
	}
</style>
