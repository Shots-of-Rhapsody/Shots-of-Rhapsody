---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

const sortedPostsList = await getSortedPostsList();
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
	<noscript>
		<nav aria-label="Archive fallback" data-archive-entry-index data-pagefind-ignore="all" class="card-base px-8 py-6 mt-4">
			<h2 class="text-xl font-bold mb-4">All articles</h2>
			<ol class="space-y-2">
				{sortedPostsList.map((post) => (
					<li>
						<a data-archive-entry-slug={post.slug} class="link text-[var(--primary)]" href={getPostUrlBySlug(post.slug)}>{post.data.title}</a>
					</li>
				))}
			</ol>
		</nav>
	</noscript>
</MainGridLayout>
