---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: unknown[];
	canonicalUrl?: string;
	socialImage?: string;
	socialImageAlt?: string | null;
	socialImageWidth?: number;
	socialImageHeight?: number;
	socialImageType?: string;
	author?: string;
	published?: Date;
	updated?: Date;
	tags?: string[];
	category?: string | null;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	canonicalUrl,
	socialImage,
	socialImageAlt,
	socialImageWidth,
	socialImageHeight,
	socialImageType,
	author,
	published,
	updated,
	tags,
	category,
} = Astro.props;
---

<Layout
	title={title}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	canonicalUrl={canonicalUrl}
	socialImage={socialImage}
	socialImageAlt={socialImageAlt}
	socialImageWidth={socialImageWidth}
	socialImageHeight={socialImageHeight}
	socialImageType={socialImageType}
	author={author}
	published={published}
	updated={updated}
	tags={tags}
	category={category}
>
	<slot slot="head" name="head" />
	<a class="skip-link" href="#main-content">Skip to content</a>
	<Navbar />
	<div class="manuscript-rule" aria-hidden="true"><span></span></div>
	<main id="main-content" tabindex="-1" class="site-main">
		<slot />
	</main>
	<Footer />
</Layout>
