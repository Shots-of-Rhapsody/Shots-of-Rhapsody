---
import "../styles/fonts.css";
import "../styles/tailwind.css";

import { getRssUrl, url } from "@utils/url-utils";
import { profileConfig, siteConfig } from "@/config";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	canonicalUrl?: string;
	socialImage?: string;
	socialImageAlt?: string | null;
	socialImageWidth?: number;
	socialImageHeight?: number;
	socialImageType?: string;
	author?: string;
	published?: Date;
	updated?: Date;
	tags?: string[];
	category?: string | null;
}

const {
	title,
	description,
	lang = siteConfig.lang,
	setOGTypeArticle = false,
	canonicalUrl,
	socialImage,
	socialImageAlt,
	socialImageWidth,
	socialImageHeight,
	socialImageType,
	author,
	published,
	updated,
	tags = [],
	category,
} = Astro.props;

const pageTitle = title
	? `${title} — ${siteConfig.title}`
	: `${siteConfig.title} — ${siteConfig.subtitle}`;
const metadataTitle = title ?? siteConfig.title;
const metadataDescription =
	description ?? "Stories, poems, and reflections by Tai Song.";
const metadataAuthor = author ?? profileConfig.name;
const canonical = new URL(
	canonicalUrl ?? Astro.url.pathname,
	Astro.site ?? Astro.url,
).toString();
const siteLang = (lang || siteConfig.lang).replace("_", "-");
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metadataDescription} />
		<meta name="author" content={metadataAuthor} />
		<meta name="theme-color" content="#f5efdf" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1b1d1a" media="(prefers-color-scheme: dark)" />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={url("/mark.svg")} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={getRssUrl(Astro.site ?? Astro.url)} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={metadataTitle} />
		<meta property="og:description" content={metadataDescription} />
		<meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && <meta property="og:image:alt" content={socialImageAlt ?? ""} />}
		{socialImage && socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
		{socialImage && socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
		{socialImage && socialImageType && <meta property="og:image:type" content={socialImageType} />}
		{setOGTypeArticle && published && <meta property="article:published_time" content={published.toISOString()} />}
		{setOGTypeArticle && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
		{setOGTypeArticle && metadataAuthor && <meta property="article:author" content={metadataAuthor} />}
		{setOGTypeArticle && category && <meta property="article:section" content={category} />}
		{setOGTypeArticle && tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<script is:inline>
			(() => {
				const stored = localStorage.getItem("theme");
				const dark = stored === "dark" ||
					(stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
				document.documentElement.classList.toggle("dark", dark);
				document.documentElement.dataset.theme = dark ? "dark" : "light";
			})();
		</script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
