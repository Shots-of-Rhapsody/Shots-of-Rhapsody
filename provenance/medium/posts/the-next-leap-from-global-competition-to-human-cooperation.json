              "bold"
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "Climate change, pandemics, and resource scarcity don’t stop at borders. But our systems still reward competition:",
            "marks": []
          }
        ]
      },
      {
        "type": "list",
        "ordered": false,
        "start": 1,
        "items": [
          [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "🏦 ",
